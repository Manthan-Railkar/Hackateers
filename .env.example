# Browser Optimizer MCP Environment Configuration

LOG_LEVEL=INFO
HEADLESS=true
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=100
BROWSER_TIMEOUT=30000
SIMILARITY_THRESHOLD=0.9
CLASSIFICATION_THRESHOLD=0.65
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8765
DASHBOARD_PORT=8050
VISUAL_FALLBACK_THRESHOLD=3

# Optional Vision AI Fallback (Groq VLM)
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Database
SQLITE_DB_PATH=cache.db
